# Cryptonauts Environment Configuration
# Copy this file to .env and fill in your values

# Gemini API Key (required for AI-generated narratives)
# Get your key at: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_api_key_here

# Optional: Custom API URL (defaults to gemini-2.0-flash)
# GEMINI_API_URL=https://generativelanguage.googleapis.com/v1beta/models/gemini-2.0-flash:generateContent

# Optional: API timeout in milliseconds (default: 15000)
# GEMINI_TIMEOUT=15000
